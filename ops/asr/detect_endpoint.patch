+# ---------------------------------------------------------------- 音乐判断（AED）
+# FireRedVAD 的多标签检测：逐帧判断说话、唱歌、音乐，输出各类的占比和起止时间。
+# 放在单独的“检测进程”里，只用 CPU、只加载这一个小模型：第一次调用时启动，空闲规则和识别进程相同。
+# 和识别进程互不影响，转写和检测可以同时进行。
+AED_CONFIG = dict(use_gpu=False, speech_threshold=0.4, singing_threshold=0.5, music_threshold=0.5,
+                  smooth_window_size=5)         # FireRedVAD 官方示例的参数；录音库的阈值是在这组参数下测出来的
+
+
+def aed_available():
+    return model_ready("FireRedVAD/AED") and (MODELS / "FireRedVAD" / "AED" / "cmvn.ark").exists()
+
+
+def detector_main():
+    """检测进程。标准输入每行一个 {"id", "wav"}（16 kHz 单声道 PCM16 WAV），标准输出每行一个结果；一次只处理一个。"""
+    proto = os.fdopen(os.dup(sys.stdout.fileno()), "wb", buffering=0)
+    os.dup2(sys.stderr.fileno(), sys.stdout.fileno())
+    sys.stdout = sys.stderr
+
+    def send(obj):
+        proto.write((json.dumps(obj, ensure_ascii=True, default=_jsonable) + "\n").encode("ascii"))
+
+    try:
+        t = time.time()
+        import soundfile as sf
+        from fireredasr2s.fireredvad import FireRedAed, FireRedAedConfig
+        aed = FireRedAed.from_pretrained(str(MODELS / "FireRedVAD" / "AED"), FireRedAedConfig(**AED_CONFIG))
+        logging.getLogger().setLevel(logging.WARNING)
+        print(f"{time.strftime('%H:%M:%S')} AED 加载完成，用时 {time.time() - t:.1f} 秒。")
+    except Exception as e:
+        traceback.print_exc()
+        send({"ready": False, "error": f"{type(e).__name__}: {e}"})
+        return
+    send({"ready": True})
+    for raw in sys.stdin.buffer:                    # 转写台关闭管道时循环结束，进程退出
+        try:
+            msg = json.loads(raw)
+        except ValueError:
+            continue
+        try:
+            with open(msg["wav"], "rb") as f:     # 自己打开文件再交给 soundfile，路径里有中文也能读
+                wav, sr = sf.read(f, dtype="int16")
+            if wav.ndim > 1:
+                wav = wav[:, 0]
+            if sr != 16000:
+                raise ValueError(f"采样率是 {sr} Hz，需要 16 kHz")
+            result, _ = aed.detect((wav, sr))
+            send({"id": msg["id"], "ok": True, "dur": result["dur"], "ratio": result["event2ratio"],
+                  "segments": {k: [[s, e] for s, e in v] for k, v in result["event2timestamps"].items()}})
+        except Exception as e:
+            traceback.print_exc()
+            send({"id": msg.get("id"), "ok": False, "error": f"{type(e).__name__}: {e}"})
+
+
+class Detector:
+    """转写台这一侧：按需启动检测进程，一次转发一个请求，空闲时让它退出。"""
+
+    def __init__(self):
+        self.proc = None
+        self.out = None
+        self.lock = threading.Lock()              # 同一时间只有一个检测请求在进行，其余排队
+        self.last = time.time()
+        self.seq = 0
+
+    def running(self):
+        return self.proc is not None and self.proc.poll() is None
+
+    def _start(self):
+        exe = Path(sys.executable)
+        if exe.name.lower() == "pythonw.exe":
+            exe = exe.with_name("python.exe")
+        DETECT_LOG.parent.mkdir(exist_ok=True)
+        log = open(DETECT_LOG, "ab")
+        log.write(f"---- {time.strftime('%Y-%m-%d %H:%M:%S')} 启动检测进程\n".encode("utf-8"))
+        log.flush()
+        self.out = queue.Queue()
+        self.proc = subprocess.Popen([str(exe), str(Path(__file__).resolve()), "--detector"], cwd=str(REPO),
+                                     stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=log,
+                                     creationflags=0x08000000 if os.name == "nt" else 0)
+        log.close()
+
+        def read(proc, out):
+            for raw in proc.stdout:
+                try:
+                    out.put(json.loads(raw))
+                except ValueError:
+                    pass
+            out.put({"exit": proc.wait()})
+        threading.Thread(target=read, args=(self.proc, self.out), daemon=True).start()
+        try:
+            msg = self.out.get(timeout=LOAD_TIMEOUT)
+        except queue.Empty:
+            msg = {"error": f"加载超过 {LOAD_TIMEOUT // 60} 分钟仍未完成"}
+        if not msg.get("ready"):
+            self._kill()
+            raise RuntimeError("音乐判断模型加载失败：" + (msg.get("error") or f"检测进程退出，退出码 {msg.get('exit')}")
+                               + "。详情见 logs\\aed_engine.log")
+
+    def _kill(self):
+        proc, self.proc = self.proc, None
+        if proc and proc.poll() is None:
+            try:
+                proc.stdin.close()
+                proc.wait(5)
+            except Exception:
+                proc.kill()
+
+    def detect(self, wav):
+        """返回检测进程的结果 {"ok", "dur", "ratio", "segments"} 或 {"ok": False, "error"}。"""
+        with self.lock:
+            try:
+                if not self.running():
+                    self._start()
+                self.seq += 1
+                self.proc.stdin.write((json.dumps({"id": self.seq, "wav": str(wav)}, ensure_ascii=True) + "\n").encode("ascii"))
+                self.proc.stdin.flush()
+                deadline = time.time() + DETECT_TIMEOUT
+                while True:
+                    try:
+                        msg = self.out.get(timeout=max(0.1, deadline - time.time()))
+                    except queue.Empty:
+                        self._kill()
+                        raise RuntimeError(f"检测超过 {DETECT_TIMEOUT // 60} 分钟仍没有结果，已结束检测进程")
+                    if "exit" in msg:
+                        self.proc = None
+                        raise RuntimeError("检测进程意外退出，详情见 logs\\aed_engine.log")
+                    if msg.get("id") == self.seq:
+                        return msg
+            except (OSError, ValueError) as e:
+                self._kill()
+                raise RuntimeError(f"无法与检测进程通信：{e}")
+            finally:
+                self.last = time.time()
+
+    def idle(self):
+        return self.running() and not self.lock.locked() and time.time() - self.last >= IDLE_UNLOAD
+
+    def stop(self):
+        with self.lock:
+            self._kill()
+
+
+DETECTOR = Detector()
