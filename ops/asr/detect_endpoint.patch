+    def api_detect(self):
+        """判断一段录音里说话、唱歌、音乐各占多少。同步返回，不进任务列表，不写 gui_outputs。
+        三种传法：JSON {"path": ...}（只限本机）、表单字段 file、请求正文就是文件（文件名放 X-Filename）。"""
+        t0 = time.time()
+        stamps = truthy(self.q("timestamps"), False)
+        temps = []
+        try:
+            if (self.headers.get("Content-Type") or "").lower().startswith("application/json"):
+                if not self.is_local():
+                    self.drain()
+                    return self.send_json({"error": "按路径检测只允许本机请求，其他设备请上传文件"}, 403)
+                path = str(self.read_json().get("path") or "").strip().strip('"')
+                if not path:
+                    return self.send_json({"error": "没有传文件：JSON 里缺少 path"}, 400)
+                src = Path(path)
+                if not src.is_file():
+                    return self.send_json({"error": f"找不到文件：{path}"}, 404)
+            else:
+                try:
+                    fields, files = self.receive_upload()
+                except ValueError as e:
+                    return self.send_json({"error": str(e)}, 400)
+                temps += [p for _, p in files]
+                if not files:
+                    return self.send_json({"error": "没有收到文件，请用表单字段 file 上传，或把文件放在请求正文里"}, 400)
+                stamps = stamps or truthy(fields.get("timestamps"), False)
+                src = Path(files[0][1])
+            suffix = src.suffix.lower()
+            if suffix and suffix not in MEDIA_SUFFIXES and suffix != ".bin":
+                return self.send_json({"error": f"不支持这种格式：{suffix}"}, 400)
+            try:
+                wav, temp = detect_audio(src)
+            except ConvertError as e:
+                return self.send_json({"error": str(e)}, 422)
+            if temp:
+                temps.append(wav)
+            try:
+                r = DETECTOR.detect(wav)
+            except RuntimeError as e:
+                return self.send_json({"error": str(e)}, 500)
+            if not r.get("ok"):
+                return self.send_json({"error": "无法读取音频：" + (r.get("error") or "未知错误")}, 422)
+            out = {"dur": r["dur"], "ratio": r["ratio"]}
+            if stamps:
+                out["segments"] = r["segments"]
+            out["elapsed"] = round(time.time() - t0, 1)
+            return self.send_json(out)
+        finally:
+            for p in temps:
+                remove_temp(p)
+
