+def detect_audio(src):
+    """准备检测用的音频：已经是 16 kHz 单声道 PCM16 的 WAV 就直接用，否则用 ffmpeg 转到 gui_work。
+    返回 (路径, 是不是临时文件)。"""
+    import soundfile as sf
+    src = Path(src)
+    if src.suffix.lower() == ".wav":
+        try:
+            with open(src, "rb") as f:
+                info = sf.info(f)
+            if info.samplerate == 16000 and info.channels == 1 and info.subtype == "PCM_16":
+                return src, False
+        except Exception:
+            pass
+    ffmpeg = shutil.which("ffmpeg")
+    if not ffmpeg:
+        raise ConvertError("需要 ffmpeg 转换格式，但没有找到 ffmpeg")
+    WORK.mkdir(exist_ok=True)
+    dst = WORK / f"detect_{secrets.token_hex(6)}.wav"
+    r = subprocess.run([ffmpeg, "-hide_banner", "-nostdin", "-y", "-i", str(src), "-vn", "-ac", "1", "-ar", "16000",
+                        "-c:a", "pcm_s16le", str(dst)], capture_output=True, text=True, encoding="utf-8",
+                       errors="replace", creationflags=0x08000000 if os.name == "nt" else 0)
+    if r.returncode != 0 or not dst.exists() or dst.stat().st_size <= 44:
+        remove_temp(dst)
+        tail = [ln.strip() for ln in (r.stderr or "").strip().splitlines() if ln.strip()][-1:]
+        raise ConvertError("ffmpeg 无法转换这个文件" + (f"：{tail[0]}" if tail else ""))
+    return dst, True
+
