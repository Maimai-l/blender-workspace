#!/bin/bash
# rv '<python dict literal for VIEW>'  -> renders and fetches renders/<name>.jpg
TOOLS=$(cd "$(dirname "$0")" && pwd)
SHARED=$(cd "$TOOLS/../../tools" && pwd)   # shared tools: xyp, bmcp, fetch, push
export XY_PROJECT="$(dirname "$TOOLS")"
T=$(python3 -I "$SHARED/xyp.py")   # work folder (see xyp.py)
PCR=$(python3 -I "$SHARED/xyp.py" --pc-root)   # project folder on the PC
NAME=$(python3 -c "import ast,sys; print(ast.literal_eval(sys.argv[1])['name'])" "$1")
python3 -I $SHARED/push.py > /dev/null
python3 -I $SHARED/bmcp.py run $TOOLS/../scripts/render_view.py "VIEW = $1" | tail -2
python3 -I $SHARED/fetch.py "$PCR\\renders\\$NAME.jpg" $T/renders/$NAME.jpg | tail -1
